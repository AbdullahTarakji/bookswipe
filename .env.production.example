# BookSwipe Production Environment Configuration

# App
DEBUG=false
ENVIRONMENT=production

# Database - Use PostgreSQL in production
DATABASE_URL=postgresql://bookswipe:CHANGE_ME@db:5432/bookswipe

# JWT - MUST change these for production
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=bookswipe-api
JWT_AUDIENCE=bookswipe-client

# Google Books API
GOOGLE_BOOKS_API_KEY=

# Rate Limiting
AUTH_RATE_LIMIT=5/minute
API_RATE_LIMIT=30/minute
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# CORS - Restrict to your domain in production
CORS_ORIGINS=["https://yourdomain.com"]
