# BookSwipe Backend Configuration

# App
DEBUG=false
ENVIRONMENT=development

# Database (SQLite for dev, PostgreSQL for prod)
# SQLite (local dev):
DATABASE_URL=sqlite:///./bookswipe.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://bookswipe:password@localhost:5432/bookswipe

# Connection pool (PostgreSQL only, ignored for SQLite)
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# JWT - CHANGE THESE IN PRODUCTION
SECRET_KEY=change-me-in-production-use-a-real-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=bookswipe-api
JWT_AUDIENCE=bookswipe-client

# Google Books API (optional - works without key but with lower rate limits)
GOOGLE_BOOKS_API_KEY=

# OAuth - Social Login
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Rate Limiting (API endpoints)
AUTH_RATE_LIMIT=5/minute
API_RATE_LIMIT=30/minute

# Rate Limiting (Google Books per-user)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (JSON list of allowed origins, use * for development only)
CORS_ORIGINS=["*"]
