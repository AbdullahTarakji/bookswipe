# ============================================================
# BookSwipe — Production Environment Configuration
# ============================================================
# Copy to .env or mount as env_file in docker-compose.
# All variables with CHANGEME must be replaced before deployment.

# ── App ──────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────
# Set via docker-compose; override here if using managed DB (RDS, Cloud SQL)
# DATABASE_URL=postgresql://bookswipe:CHANGEME@prod-db:5432/bookswipe
POSTGRES_USER=bookswipe
POSTGRES_PASSWORD=CHANGEME_prod_db_password
POSTGRES_DB=bookswipe

# Connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Redis ────────────────────────────────────────────────────
# Set via docker-compose; override here if using managed Redis (ElastiCache)
# REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20

# ── JWT / Auth ───────────────────────────────────────────────
SECRET_KEY=CHANGEME_prod_secret_key_min_64_chars_use_openssl_rand
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=bookswipe-api
JWT_AUDIENCE=bookswipe-client

# ── OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGEME
APPLE_CLIENT_ID=CHANGEME

# ── Google Books API ────────────────────────────────────────
GOOGLE_BOOKS_API_KEY=CHANGEME

# ── Admin Seeding ──────────────────────────────────────────
ADMIN_EMAIL=CHANGEME
ADMIN_PASSWORD=CHANGEME

# ── RevenueCat (mobile in-app subscriptions) ───────────────
REVENUECAT_API_KEY=CHANGEME
REVENUECAT_WEBHOOK_SECRET=CHANGEME

# ── Stripe (web-only subscriptions) ───────────────────────
STRIPE_SECRET_KEY=CHANGEME
STRIPE_WEBHOOK_SECRET=CHANGEME
STRIPE_PRICE_ID=CHANGEME
STRIPE_SUCCESS_URL=https://bookswipe.app/payment/success
STRIPE_CANCEL_URL=https://bookswipe.app/payment/cancel
FREE_TIER_DAILY_SWIPE_LIMIT=10

# ── Rate Limiting ───────────────────────────────────────────
AUTH_RATE_LIMIT=5/minute
API_RATE_LIMIT=30/minute
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["https://bookswipe.app"]

# ── Gunicorn ─────────────────────────────────────────────────
WEB_CONCURRENCY=4

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=CHANGEME
PROMETHEUS_ENABLED=true

# ── Backups ──────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=7

# ── Nginx / SSL ──────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN=bookswipe.app

# ── Backups (S3 offsite — optional) ─────────────────────────
# S3_BACKUP_BUCKET=bookswipe-backups
# AWS_ACCESS_KEY_ID=CHANGEME
# AWS_SECRET_ACCESS_KEY=CHANGEME
# AWS_DEFAULT_REGION=eu-central-1
