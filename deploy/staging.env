# ============================================================
# BookSwipe — Staging Environment Configuration
# ============================================================
# Copy to .env or mount as env_file in docker-compose.
# All variables with CHANGEME must be replaced before deployment.

# ── App ──────────────────────────────────────────────────────
ENVIRONMENT=staging
DEBUG=false
APP_VERSION=1.0.0
LOG_LEVEL=DEBUG

# ── Database (separate staging instance — never share prod) ─
# Set via docker-compose; override here if using external DB
# DATABASE_URL=postgresql://bookswipe:CHANGEME@staging-db:5432/bookswipe_staging
POSTGRES_USER=bookswipe
POSTGRES_PASSWORD=CHANGEME_staging_db_password
POSTGRES_DB=bookswipe_staging

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Redis ────────────────────────────────────────────────────
# Set via docker-compose; override here if using external Redis
# REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=10

# ── JWT / Auth ───────────────────────────────────────────────
SECRET_KEY=CHANGEME_staging_secret_key_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=bookswipe-api
JWT_AUDIENCE=bookswipe-client

# ── OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ── Google Books API ────────────────────────────────────────
GOOGLE_BOOKS_API_KEY=

# ── Rate Limiting ───────────────────────────────────────────
AUTH_RATE_LIMIT=10/minute
API_RATE_LIMIT=60/minute
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["https://staging.bookswipe.app"]

# ── Gunicorn ─────────────────────────────────────────────────
WEB_CONCURRENCY=2

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# ── Backups ──────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=3

# ── Nginx ────────────────────────────────────────────────────
HTTP_PORT=80
